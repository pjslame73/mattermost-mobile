## Build de release de Socratix para Android.
## Uso:  bundle exec fastlane android build --env android.socratix
##
## Este archivo SE COMMITEA: no pongas secretos aca.
## Los secretos (SUPPLY_JSON_KEY, credenciales del keystore) van en
## fastlane/.env (gitignored) y en android/gradle.properties.

APP_NAME=Socratix
APP_SCHEME=socratix
APP_AUTH_SCHEME=socratixauth
APP_AUTH_SCHEME_BETA=socratixauthbeta

## El lane update_identifiers usa esto para reescribir applicationId, namespace,
## mover el paquete Java y arreglar los imports. No hace falta tocar build.gradle.
MAIN_APP_IDENTIFIER=site.conversa.chat
SUPPLY_PACKAGE_NAME=site.conversa.chat

BETA_BUILD=false
BUILD_FOR_RELEASE=true
REPLACE_ASSETS=true

## AAB para Google Play. Para un APK instalable a mano: ANDROID_BUILD_TASK=assemble
ANDROID_BUILD_TASK=bundle
SEPARATE_APKS=false
UNIVERSAL_APK=false

SENTRY_ENABLED=false
COLLECT_NETWORK_METRICS=false

## Poner en true cuando quieras que el build suba solo a Google Play
SUBMIT_ANDROID_TO_GOOGLE_PLAY=false
SUPPLY_TRACK=internal
SUPPLY_VALIDATE_ONLY=false
