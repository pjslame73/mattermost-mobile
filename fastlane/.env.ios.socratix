## Build de release de Socratix para iOS.
## Uso:  bundle exec fastlane ios build --env ios.socratix
##
## Este archivo SE COMMITEA: no pongas secretos aca.
## Los secretos (MATCH_PASSWORD, FASTLANE_PASSWORD, MATCH_GIT_URL, API keys)
## van en fastlane/.env, que si esta en .gitignore.

APP_NAME=Socratix
APP_SCHEME=socratix

## Esquemas de callback de SSO. Si no los seteas, el lane `configure` del
## Fastfile pisa el config.json y los deja en mmauth/mmauthbeta.
APP_AUTH_SCHEME=socratixauth
APP_AUTH_SCHEME_BETA=socratixauthbeta

## Identificadores. El Fastfile hace find_replace_string sobre project.pbxproj
## reemplazando com.mattermost.rnbeta, asi que las dos extensiones se derivan solas.
MAIN_APP_IDENTIFIER=site.conversa.chat
EXTENSION_APP_IDENTIFIER=site.conversa.chat.MattermostShare
NOTIFICATION_SERVICE_IDENTIFIER=site.conversa.chat.NotificationService
IOS_APP_GROUP=group.site.conversa.chat

## IOS_ICLOUD_CONTAINER va vacio a proposito. Sacamos las claves de iCloud de
## Mattermost.entitlements, y el Fastfile solo llama a
## update_icloud_container_identifiers si esta variable tiene valor.
## Si algun dia se vuelve a querer iCloud: setear el container aca y devolver
## las 4 claves al entitlements.

## Firma
FASTLANE_TEAM_ID=MQYA69HPUQ
IOS_BUILD_EXPORT_METHOD=app-store
MATCH_TYPE=appstore
MATCH_APP_IDENTIFIER=site.conversa.chat.NotificationService,site.conversa.chat.MattermostShare,site.conversa.chat
MATCH_READONLY=false
MATCH_SHALLOW_CLONE=true
MATCH_SKIP_DOCS=true
## Pasa a true recien cuando tengas el repo privado de match configurado
## (MATCH_GIT_URL + MATCH_PASSWORD en fastlane/.env).
SYNC_PROVISIONING_PROFILES=false

## Build de release (no beta): usa APP_AUTH_SCHEME, no el _BETA.
BETA_BUILD=false
BUILD_FOR_RELEASE=true
REPLACE_ASSETS=true

FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT=120
FASTLANE_XCODEBUILD_SETTINGS_RETRIES=6

## Servicios de Mattermost que no usamos
SENTRY_ENABLED=false
INTUNE_ENABLED=false
COLLECT_NETWORK_METRICS=false

## OJO: SUBMIT_IOS_TO_TESTFLIGHT no lo lee nadie. Esta en los .env de upstream
## pero no aparece en el Fastfile ni en los workflows: ponerlo en true no hace
## nada. La subida la hace la lane `ios deploy`, que es un comando aparte.
##
## Para publicar:  npm run testflight:ios
## (scripts/testflight.sh encadena `ios build` + `ios deploy` con este entorno)
SUBMIT_IOS_TO_TESTFLIGHT=false
PILOT_SKIP_WAITING_FOR_BUILD_PROCESSING=true
