## Plantilla de fastlane/.env — SECRETOS.
##
## Copiar a fastlane/.env y completar. Ese archivo está en .gitignore
## (línea `**/fastlane/.env`) y no se commitea nunca.
##
## Los valores NO sensibles (identificadores, esquemas, team ID, toggles)
## viven en .env.ios.socratix y .env.android.socratix, que sí se commitean.

############ APP STORE CONNECT — API KEY ############
## Vía recomendada para TestFlight: no usa contraseña de Apple ID ni 2FA.
## Se genera en App Store Connect → Usuarios y accesos → Integraciones →
## Claves de API. Rol mínimo: App Manager.
##
## IOS_API_KEY es el contenido del .p8 en UNA sola línea, con los saltos
## de línea escritos literalmente como \n (el Fastfile los reexpande en
## get_apple_api_key). Incluir las líneas BEGIN/END.
IOS_API_KEY_ID=
IOS_API_ISSUER_ID=
IOS_API_KEY=

############ MATCH — PROVISIONING PROFILES ############
## Repositorio git PRIVADO donde match guarda certificados y perfiles
## cifrados. Tiene que existir y estar vacío la primera vez.
MATCH_GIT_URL=
## Passphrase con la que match cifra el repo. Inventala una vez y guardala:
## sin ella no se pueden recuperar los certificados.
MATCH_PASSWORD=
## Password del usuario del Mac que corre el build (para desbloquear el
## llavero). En una máquina de CI suele ser el del usuario de servicio.
MATCH_KEYCHAIN_PASSWORD=

############ SOLO SI NO USÁS API KEY ############
## Alternativa por Apple ID. Requiere app-specific password y complica el 2FA.
## Si completaste el bloque de API key, dejá esto vacío.
#FASTLANE_USER=
#FASTLANE_PASSWORD=
#MATCH_USERNAME=

############ OPCIONAL ############
## Webhook de Mattermost para avisar cuando termina el build.
#MATTERMOST_WEBHOOK_URL=
